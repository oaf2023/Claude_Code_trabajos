google-services.json
GoogleService-Info.plist

# Firebase functions
functions/node_modules/
functions/lib/
functions/.env

# typescript
*.tsbuildinfo

# coverage
coverage/

# generated native folders
/ios
/android

# Python
__pycache__/
*.pyc

