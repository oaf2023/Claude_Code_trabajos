# ============================================================================
# Archivo         : .env.example
# Descripción     : Variables de entorno para SafeAlert App (React Native / Expo)
# Autor           : oafon
# Fecha           : 2026-07-30
# Versión         : 3.0.0
# Uso             : Copiar a .env y configurar valores
# ============================================================================

# --- Feature flags ---
EXPO_PUBLIC_ENABLE_WAKE_WORD=false
EXPO_PUBLIC_ENABLE_AUDIO_GUARD=false
# ⚠️  [FASE 0] Pagos congelados. Habilitar solo tras Fase 2+4 completadas.
EXPO_PUBLIC_ENABLE_PAYMENTS=false
EXPO_PUBLIC_ENABLE_PAYMENTS_DEMO=false
EXPO_PUBLIC_ENABLE_BACKGROUND_LOCATION=false

# --- APIs ---
EXPO_PUBLIC_PA_API_URL=https://oaf.pythonanywhere.com
EXPO_PUBLIC_PA_API_KEY=
EXPO_PUBLIC_PA_INTERNAL_KEY=
EXPO_PUBLIC_PA_SYNC_SECRET=
EXPO_PUBLIC_AUDIO_ALERT_API_URL=
EXPO_PUBLIC_AUDIO_ALERT_API_KEY=
EXPO_PUBLIC_WAKE_WORD_LICENSE=

# --- Debug ---
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ENVIRONMENT=development
