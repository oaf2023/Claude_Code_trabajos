# SafeAlert MVP cliente
# No guardes secretos en este archivo. Firebase en móvil depende de:
# - android/app/google-services.json
# - ios/GoogleService-Info.plist

# Flags del MVP publicable
EXPO_PUBLIC_ENABLE_WAKE_WORD=false
EXPO_PUBLIC_ENABLE_BACKGROUND_LOCATION=false
EXPO_PUBLIC_WAKE_WORD_LICENSE=

# El cliente móvil no requiere claves secretas para Twilio.
# Las credenciales del proveedor van solo en functions/.env
