{
    "env": {
        "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
        "ANTHROPIC_AUTH_TOKEN": "",
        "ANTHROPIC_API_KEY": "",
        "ANTHROPIC_MODEL": "openrouter/free"
    },
    "permissions": {
        "allow": [
            "Bash",
            "Edit",
            "Glob",
            "Grep",
            "LS",
            "MultiEdit",
            "Read",
            "Write"
        ],
        "deny": [
            "Read(**/.env*)",
            "Read(**/google-services.json)",
            "Read(**/GoogleService-Info.plist)"
        ]
    }
}
